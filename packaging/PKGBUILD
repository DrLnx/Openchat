# Maintainer: n3xtpy <business@n3xt-agency.com>
#
# Arch / Manjaro package. Submit to the AUR with:
#
#   git clone ssh://aur@aur.archlinux.org/openchat.git aur-openchat
#   cp packaging/PKGBUILD aur-openchat/
#   cd aur-openchat && makepkg --printsrcinfo > .SRCINFO
#   git add PKGBUILD .SRCINFO && git commit -m 'openchat 0.1.0' && git push
#
# Test it locally first with `makepkg -si` from a copy of this directory.

pkgname=openchat
pkgver=0.1.0
pkgrel=1
pkgdesc='Serverless, end-to-end encrypted group chat and DMs for your terminal, over a P2P DHT'
arch=('x86_64' 'aarch64')
url='https://github.com/n3xtpy/Openchat'
license=('MIT')
depends=('nodejs>=22')
makedepends=('npm' 'git' 'python' 'base-devel')
source=("$pkgname-$pkgver.tar.gz::https://github.com/n3xtpy/Openchat/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum once the tag exists:
#   makepkg -g >> PKGBUILD
sha256sums=('SKIP')

build() {
  cd "$srcdir/Openchat-$pkgver"

  # Native modules (sodium-native, udx-native) resolve prebuilds here; the
  # makedepends above cover the fallback to building from source.
  npm ci
  npm run build
}

check() {
  cd "$srcdir/Openchat-$pkgver"
  npm run lint
}

package() {
  cd "$srcdir/Openchat-$pkgver"

  local _libdir="$pkgdir/usr/lib/$pkgname"
  install -dm755 "$_libdir"

  # Ship the built output and the runtime dependencies, not the whole checkout.
  cp -r bin dist package.json "$_libdir/"
  cd "$srcdir/Openchat-$pkgver"
  npm ci --omit=dev --prefix "$_libdir" >/dev/null

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/bin/openchat.js" "$pkgdir/usr/bin/openchat"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
