{
  "name": "openchat",
  "version": "0.1.0",
  "description": "Serverless, end-to-end encrypted group chat and DMs for your terminal, over a P2P DHT",
  "keywords": [
    "chat",
    "p2p",
    "e2ee",
    "encryption",
    "terminal",
    "cli",
    "hypercore",
    "hyperswarm",
    "holepunch",
    "dht",
    "serverless",
    "tui"
  ],
  "homepage": "https://github.com/n3xtpy/Openchat#readme",
  "bugs": {
    "url": "https://github.com/n3xtpy/Openchat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n3xtpy/Openchat.git"
  },
  "author": "n3xtpy",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openchat": "bin/openchat.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:web": "node scripts/build-web.js",
    "dev": "node scripts/build.js --watch",
    "pretest": "npm run build",
    "test": "node --import ./scripts/jsx-register.js --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --import ./scripts/jsx-register.js --test \"test/unit/*.test.js\"",
    "record": "node scripts/record-demo.js",
    "shot": "FORCE_COLOR=3 COLORTERM=truecolor TERM=xterm-256color node --import ./scripts/jsx-register.js scripts/screenshot.js",
    "start": "node bin/openchat.js",
    "demo": "node --import ./scripts/jsx-register.js scripts/demo-tour.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "prepack": "npm run build",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "autobase": "^7.28.1",
    "b4a": "^1.8.1",
    "bip39": "^3.1.0",
    "compact-encoding": "^3.3.2",
    "corestore": "^7.12.2",
    "hyperbee": "^2.27.3",
    "hyperblobs": "^2.12.1",
    "hypercore": "^11.35.2",
    "hyperdht": "^6.33.2",
    "hyperswarm": "^4.17.0",
    "ink": "^7.1.1",
    "protomux": "^3.11.0",
    "react": "^19.2.8",
    "sodium-native": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "playwright": "^1.62.1",
    "standard": "^17.1.2"
  }
}
